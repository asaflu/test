# Twitter Account to Monitor (no API key needed - using snscrape)
TWITTER_ACCOUNT=ultrawavetrader

# IBKR Configuration
IBKR_HOST=127.0.0.1
IBKR_PORT=7497  # 7497 for TWS paper trading, 7496 for TWS live, 4002 for IB Gateway paper, 4001 for IB Gateway live
IBKR_CLIENT_ID=1

# Trading Configuration
POSITION_SIZE_MULTIPLIER=0.10  # 10% of mentioned size
DEFAULT_ACCOUNT=your_account_id  # Your IBKR account ID

# Risk Management
MAX_POSITION_SIZE=10000  # Maximum position size in USD
ENABLE_TRADING=false  # Set to true to enable actual trading (starts in dry-run mode)

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
